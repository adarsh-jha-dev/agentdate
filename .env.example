# Copy to .env (or .env.local) and fill in. Never commit the real file.

# Neon Postgres connection string (Neon dashboard -> Connect). Then run: npm run db:push
DATABASE_URL=postgresql://user:password@host.neon.tech/db?sslmode=require

# Apify (console.apify.com -> Settings -> API & Integrations)
APIFY_TOKEN=
# Actors used for scraping. Both are pay-per-result and need no cookies.
APIFY_IG_ACTOR=apify/instagram-profile-scraper
APIFY_LI_ACTOR=harvestapi/linkedin-profile-scraper

# OpenAI (platform.openai.com -> API keys)
OPENAI_API_KEY=
# Profile analysis and date debriefs
MODEL_SMART=gpt-5
# Prescoring, date settings and date turns
MODEL_FAST=gpt-5-mini

# Set to true on public deployments: turns off adding people, matching and dates (anything that
# spends Apify/OpenAI credits). Browsing profiles, transcripts, rankings and /demo still works.
READ_ONLY=false
